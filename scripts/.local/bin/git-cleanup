#!/usr/bin/env zsh

# Fetch remote branches and prune deleted ones
git fetch -p || exit $?

# Skip branches checked out in any worktree, even if their origin upstream is gone.
setopt pipefail
LC_ALL=C git for-each-ref refs/heads \
  --format='%(refname:lstrip=2):%(upstream:remotename):%(upstream:track):%(if)%(worktreepath)%(then)in-use%(end)' |
  while IFS=: read -r branch remote tracking worktree; do
    if [[ $remote == origin && $tracking == '[gone]' && -z $worktree ]]; then
      git branch -D -- "$branch" || exit $?
    fi
  done
